# Envio do formulário de contato (Resend). Copie para .env.local e preencha;
# nunca versione os valores reais. As três variáveis são lidas só no servidor.

# Chave de API do Resend (permissão só de envio).
RESEND_API_KEY=

# Remetente completo, com nome.
#   Teste (sem domínio verificado):  Contato Tritonia <onboarding@resend.dev>
#     -> só entrega no e-mail da conta do Resend.
#   Definitivo (domínio verificado): Contato Tritonia <contato@tritonia.com.br>
CONTACT_FROM_EMAIL=

# Destino. Aceita vários endereços separados por vírgula.
#   Teste:       o e-mail da conta do Resend.
#   Definitivo:  gabriel.nobre@tritonia.dev.br
CONTACT_TO_EMAIL=
